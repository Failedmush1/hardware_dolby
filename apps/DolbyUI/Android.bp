android_app {
    name: "DolbyAtmos",

    srcs: ["src/co/aospa/dolby/DolbyActivity.kt", "src/co/aospa/dolby/DolbyController.kt", "src/co/aospa/dolby/preference/DolbySettingsFragment.kt", "src/co/aospa/dolby/preference/DolbyIeqPreference.kt", "src/co/aospa/dolby/preference/DolbyPreferenceStore.kt", "src/co/aospa/dolby/BootCompletedReceiver.kt", "src/co/aospa/dolby/DolbyAudioEffect.kt", "src/co/aospa/dolby/DolbyConstants.kt", "src/co/aospa/dolby/DolbyTileService.kt", "src/co/aospa/dolby/SummaryProvider.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    overrides: ["MusicFX", "AudioFX"],
    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "org.lineageos.settings.resources",
    ],

    required: ["preinstalled-packages-platform-dolby.xml"],
}

prebuilt_etc {
    name: "preinstalled-packages-platform-dolby.xml",
    src: "preinstalled-packages-platform-dolby.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
